# ── NATS ──────────────────────────────────────────────────────────────────────
# Must point at the same NATS cluster used by credebl/platform.
NATS_URL=nats://localhost:4222
# nkey | creds | usernamePassword | none
NATS_AUTH_TYPE=creds
# nkey seed for this service's identity (service name must remain "cloud-wallet")
CLOUD_WALLET_NKEY_SEED=
# Path to NATS credentials file (when NATS_AUTH_TYPE=creds)
NATS_CREDS_FILE=/path/to/cloud-wallet.creds
# Only when NATS_AUTH_TYPE=usernamePassword
NATS_USER=
NATS_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
# This service owns its table `cloud_wallet_user_info` and its own migrations
# (libs/prisma-service/prisma/migrations). DATABASE_URL is used by
# `prisma migrate deploy` at container start; POOL_DATABASE_URL by runtime queries.
POOL_DATABASE_URL=postgresql://user:password@localhost:5432/credebl?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/credebl?schema=public

# ── Crypto ────────────────────────────────────────────────────────────────────
# MUST be byte-identical to platform's CRYPTO_PRIVATE_KEY — every stored
# agentApiKey and wallet key in cloud_wallet_user_info is AES-encrypted with it.
CRYPTO_PRIVATE_KEY=

# ── Secrets provider (optional — OpenBao) ─────────────────────────────────────
ENABLE_BAO=false
# openbao (or as configured)
SECRETS_PROVIDER=
BAO_URL=
BAO_ROLE_ID=
BAO_SECRET_ID=
BAO_SECRET_PATH=

# ── Logging (optional) ────────────────────────────────────────────────────────
# PRISMA_LOGS=true
# IS_ENABLE_OTEL=true   # no-op in this service post-extraction (OTel lives in platform's api-gateway)
