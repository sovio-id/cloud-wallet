{
  "name": "cloud-wallet",
  "version": "0.1.0",
  "description": "CREDEBL Cloud Wallet microservice (extracted from credebl/platform)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\"",
    "prisma:generate": "npx prisma generate --schema=libs/prisma-service/prisma/schema.prisma",
    "prisma:validate": "npx prisma validate --schema=libs/prisma-service/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate deploy --schema=libs/prisma-service/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.29",
    "@nestjs/microservices": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^7.7.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "nestjs-cls": "^6.2.1",
    "nats": "^2.29.3",
    "nodemailer": "^9.1.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.1.14",
    "resend": "^6.9.2",
    "rxjs": "^7.8.2",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "^11.0.7",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.33",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "prettier": "^3.8.1",
    "rimraf": "^3.0.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
